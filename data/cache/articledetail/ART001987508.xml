        <title-group>
          <article-title lang="original"><![CDATA[우리는 어떻게 공감하는가?: 메를로퐁티의 대답]]></article-title>
          <article-title lang="foreign"><![CDATA[How can We empathize with each Other? : An Answer from Merleau-Ponty]]></article-title>
          <article-title lang="english"><![CDATA[How can We empathize with each Other? : An Answer from Merleau-Ponty]]></article-title>
        </title-group>
        <author-group>
          <author author-division="1" author-part="단독">
