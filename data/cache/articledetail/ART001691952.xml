        <title-group>
          <article-title lang="original"><![CDATA[자유의 문제: 메를로-퐁티와 사르트르]]></article-title>
          <article-title lang="foreign"><![CDATA[The Problem of Freedom: Merleau-Ponty and Sartre]]></article-title>
          <article-title lang="english"><![CDATA[The Problem of Freedom: Merleau-Ponty and Sartre]]></article-title>
        </title-group>
