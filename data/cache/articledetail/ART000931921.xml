        <title-group>
          <article-title lang="original"><![CDATA[헌신과 개입: 존 파울즈의 실존주의 세계관]]></article-title>
          <article-title lang="foreign"><![CDATA[Commitment and Involvement: John Fowles' s Existentialism]]></article-title>
          <article-title lang="english"><![CDATA[Commitment and Involvement: John Fowles' s Existentialism]]></article-title>
        </title-group>
        <author-group>
          <author author-division="1">
            <name><![CDATA[배현]]></name>
