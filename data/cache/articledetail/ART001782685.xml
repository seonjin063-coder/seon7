        <title-group>
          <article-title lang="original"><![CDATA[인간이해에 있어서 실존주의의 두 지평과 가브리엘 마르셀의 상호주관성]]></article-title>
          <article-title lang="foreign"><![CDATA[Deux perspectives de l'existentialisme sur la compréhension de l'homme et l'inter-subjectivité chez G. Marcel]]></article-title>
          <article-title lang="english"><![CDATA[Deux perspectives de l'existentialisme sur la compréhension de l'homme et l'inter-subjectivité chez G. Marcel]]></article-title>
