        <title-group>
          <article-title lang="original"><![CDATA[사르트르의 실존주의 철학이 도덕교육에 주는 시사]]></article-title>
          <article-title lang="foreign"><![CDATA[Implications of Sartre's Existentialism Philosophy on the Moral Education]]></article-title>
          <article-title lang="english"><![CDATA[Implications of Sartre's Existentialism Philosophy on the Moral Education]]></article-title>
        </title-group>
        <author-group>
          <author author-division="1" author-part="단독">
