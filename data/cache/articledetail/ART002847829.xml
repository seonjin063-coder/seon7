        <title-group>
          <article-title lang="original"><![CDATA[현대사회 실존적 공허에 대처하는 여가참여의 방향]]></article-title>
          <article-title lang="foreign"><![CDATA[Leisure and the Existential Vacuum in Modern Society]]></article-title>
          <article-title lang="english"><![CDATA[Leisure and the Existential Vacuum in Modern Society]]></article-title>
        </title-group>
