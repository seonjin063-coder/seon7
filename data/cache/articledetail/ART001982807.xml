        <title-group>
          <article-title lang="original"><![CDATA[인간의 생물학적 현사실성과 실존적 자유]]></article-title>
          <article-title lang="foreign"><![CDATA[The Biological Facticity of Man and the Existential Freedom]]></article-title>
          <article-title lang="english"><![CDATA[The Biological Facticity of Man and the Existential Freedom]]></article-title>
