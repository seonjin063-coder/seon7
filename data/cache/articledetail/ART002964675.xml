        <title-group>
          <article-title lang="original"><![CDATA[사르트르 철학과 현대사회와 자유, 그리고 책임의 문제]]></article-title>
          <article-title lang="foreign"><![CDATA[Sartre philosophy and problems of modern society and freedom and responsibility]]></article-title>
          <article-title lang="english"><![CDATA[Sartre philosophy and problems of modern society and freedom and responsibility]]></article-title>
        </title-group>
        <author-group>
          <author author-division="1" author-part="단독">
