        <title-group>
          <article-title lang="original"><![CDATA[자유의 절대성과 현존재]]></article-title>
          <article-title lang="foreign"><![CDATA[The Absoluteness of Ontological Freedom and Dasein]]></article-title>
          <article-title lang="english"><![CDATA[The Absoluteness of Ontological Freedom and Dasein]]></article-title>
