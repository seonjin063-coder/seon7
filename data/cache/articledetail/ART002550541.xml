        <title-group>
          <article-title lang="original"><![CDATA[허수경과 하이즈(海子)시 비교연구- 도시와 육체의 시적 표상을 중심으로]]></article-title>
          <article-title lang="foreign"><![CDATA[A Comparative Study of Hur, Soo-kyung and Heise’s Poem : Focusing on the Poetic Representation of the City and the Body]]></article-title>
          <article-title lang="english"><![CDATA[A Comparative Study of Hur, Soo-kyung and Heise’s Poem : Focusing on the Poetic Representation of the City and the Body]]></article-title>
        </title-group>
        <author-group>
          <author author-division="1" author-part="제1">
            <name><![CDATA[정둥메이]]></name>
            <name-eng><![CDATA[鄭冬梅]]></name-eng>
            <institution>산동대학교 한국학대학 한국어학과</institution>
          </author>
          <author author-division="2" author-part="교신">
