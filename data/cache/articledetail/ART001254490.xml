        <title-group>
          <article-title lang="original"><![CDATA[‘주체로의 복귀’와 새로운 윤리의 가능성: 바디우와 지젝]]></article-title>
          <article-title lang="foreign"><![CDATA[The Return to the Subject and the Possibility of Ethics: Badiou and Žižek]]></article-title>
          <article-title lang="english"><![CDATA[The Return to the Subject and the Possibility of Ethics: Badiou and Žižek]]></article-title>
